# Run python3 scripts/setup_env.py to create .env with generated local secrets.
POSTGRES_DB=financial_copilot
POSTGRES_PASSWORD=replace-with-generated-admin-secret
MIGRATION_DB_PASSWORD=replace-with-generated-owner-secret
APP_DB_PASSWORD=replace-with-generated-app-secret
DATABASE_URL=postgresql+psycopg://fhc_app:replace-with-generated-app-secret@localhost:5432/financial_copilot
MIGRATION_DATABASE_URL=postgresql+psycopg://fhc_owner:replace-with-generated-owner-secret@localhost:5432/financial_copilot
JWT_SECRET=replace-with-generated-jwt-secret
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional Phase 5 provider settings. No LLM key is required for deterministic mode.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=12
LLM_MAX_TOOL_CALLS=3
AI_MODE=auto
CLOUD_AI_CONSENT_GRANTED=false
